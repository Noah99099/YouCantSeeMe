  destroyOjb_AfterGetInfos: {fileID: 984260248}
  text_1: "\u8ACB\u62FF\u53D6\u5E73\u9762\u5716\u548C\u6848\u4EF6\u7D00\u9304\u7C3F"
  text_2: "\u8ACB\u524D\u5F80\u6848\u767C\u73FE\u5834\u2014\u98EF\u5EF3"
  text_3: "\u8ABF\u67E5\u6B7B\u8005\u6B7B\u56E0"
  text_4: "\u7372\u5F97\u6B7B\u56E0\u8ABF\u67E5\u7D50\u679C"
  text_5: "\u89E3\u958B\u98EF\u5EF3\u7684\u6CD5\u9663"
  text_newsBuild: "\u7372\u5F97\u5289\u6C0F\u96C6\u5718\u5EFA\u6848\u5B8C\u5DE5\u5831\u5C0E"
  text_news1: "\u7372\u5F97\u5289\u5B85\u547D\u6848\u5831\u5C0E-1"
  text_news2: "\u7372\u5F97\u5289\u5B85\u547D\u6848\u5831\u5C0E-2"
  text_news3: "\u7372\u5F97\u5289\u5B85\u547D\u6848\u5831\u5C0E-3"
  text_picture: "\u7372\u5F97\u6848\u4EF6\u7576\u5929\u7684\u5408\u7167"
  text_afterGhost1: "\u8ACB\u7E7C\u7E8C\u8ABF\u67E5\u98EF\u5EF3\u56DB\u5468\u8207\u5EDA\u623F"
  text_afterGhost2: "\u7372\u5F97\u8D70\u5ECA\u76E1\u982D\u4EBA\u7684\u59FF\u52E2\u5DEE\u7570"
  text_endToKitchen: "\u8ACB\u9084\u539F\u547D\u6848\u7576\u5929\u7684\u805A\u9910\u83DC\u55AE"
  text_endKRInfo: "\u8ACB\u524D\u5F80\u4E00\u6A13\u7684\u5176\u4ED6\u623F\u9593\u8ABF\u67E5"
  id_voiceItem: 
  text_vDB: "\u7372\u5F97\u98EF\u5EF3\u756B\u4E0A\u7684\u5B50\u5F48"
  text_vKB: "\u7372\u5F97\u5EDA\u623F\u8D70\u5ECA\u7684\u5B50\u5F48"
  text_vRod: "\u7372\u5F97\u4E7E\u6EBC\u66EC\u8863\u687F\u7684\u4E0D\u540C"
  text_krInfo_1: "\u7372\u5F97\u8CC7\u8A0A\u7D19\u689D-\u5B89\u7720\u85E5"
  text_krInfo_2: "\u7372\u5F97\u8CC7\u8A0A\u7D19\u689D-\u6BD2\u85E5"
  text_krInfo_3: "\u7372\u5F97\u8CC7\u8A0A\u7D19\u689D-\u8292\u679C\u88FD\u54C1"
