  itemName: "\u98EF\u5EF3\u7684\u5B50\u5F48\u5F48\u982D"
  voiceIcon: {fileID: 21300000, guid: 45703446b609696428c9b2e5d848ab7c, type: 3}
  voiceItemID: BulletWarhead_DiningRoom
  voiceItem: {fileID: 3780846598116427307, guid: ad9fd43f34b0f7f419ad17161e169533,
    type: 3}
  itemScale: 4
  titleText: "\u98EF\u5EF3\u7684\u5B50\u5F48\u5F48\u982D\u7684\u8072\u97F3"
  descText_Before: "\u5728\u9670\u8996\u91CE\u7684\u98EF\u5EF3\u7684\u756B\u4E0A\u627E\u5230\u4E00\u500B\u5B50\u5F48\u7684\u5F48\u982D"
  descText_After: "\uFF08\u69CD\u64CA\u8072\u5169\u4E0B\uFF09\u7830\u7830\u2014\n\u5FAE\u84BC\u8001\u7684\u5973\u6027\u8072\u97F3\uFF1A\u5148...\u751F...\uFF1F\n\uFF08\u5012\u5730\u8072\uFF09\n\u5973\u6027\u8072\u97F3\uFF1A\u554A\u2014\u2014\uFF08\u5C16\u53EB\u8072\uFF09\n\u4E2D\u5E74\u7537\u6027\u8072\u97F3\uFF1A\u4EC0\u9EBC\u8072\u97F3\uFF1F\uFF08\u6905\u5B50\u79FB\u52D5\u8072\uFF09\u767C\u751F\u4EC0\u9EBC\u4E8B\u4E86\uFF1F\n\uFF08\u6905\u5B50\u79FB\u8072\u3001\u8173\u6B65\u8072\uFF09\n\u5973\u6027\u8072\u97F3\uFF1A\u8840...\u5979\u6D41\u4E86\u597D\u591A\u8840\uFF08\u5BB3\u6015\u7684\u8A9E\u6C23\uFF09\u3002\n\u4E2D\u5E74\u7537\u6027\u8072\u97F3\uFF1A\u8981...\u8981\u5FEB\u9EDE\u9003\u8D70\uFF08\u614C\u5F35\u7684\u8A9E\u6C23\uFF09\u3002\n\uFF08\u6025\u4FC3\u4E26\u614C\u5F35\u7684\u8173\u6B65\u8072\uFF09\n\uFF08\u69CD\u64CA\u8072\u5169\u4E0B\uFF09\u7830\u7830\u2014"
