  titleText: "\u5EDA\u623F\u7684\u5B50\u5F48\u5F48\u982D\u7684\u8072\u97F3"
  descText_Before: "\u5728\u967D\u8996\u91CE\u7684\u9760\u8FD1\u5EDA\u623F\u7684\u6D74\u5EC1\u7246\u58C1\u4E0A\u627E\u5230\u4E00\u500B\u5B50\u5F48\u7684\u5F48\u982D\u3002"
  descText_After: "\u4E2D\u5E74\u7537\u6027\u8072\u97F3\uFF1A\u5443\u2014\u2014\uFF08\u75DB\u82E6\u547B\u541F\u8072\uFF09\n\u5973\u6027\u555C\u6CE3\u8072\uFF1A\u597D\u75DB...\u597D\u75DB...\n\u96DC\u97F3\u2014\n\uFF08\u91CD\u7269\u62D6\u62FD\u8072+\u8D70\u8DEF\u8072\uFF09\n\uFF08\u8D70\u8DEF\u8072\uFF09\n\u96DC\u97F3\u2014\n\uFF08\u9418\u8072\uFF09\u5679\u2014\u5679\u2014\u5679\u2014\u5679\u2014\u5679\u2014\u5679\u2014\u5679\u2014\n\uFF08\u91CD\u7269\u62D6\u62FD\u8072+\u8D70\u8DEF\u8072\uFF09\n\u96DC\u97F3\u2014\n\u7830\u7830\u7830\u2014\u7830\u7830\u7830\u2014\u7830\u7830\u2014\u5494\u2014\u5494\u2014"
